<UserControl
    x:Class="ScopeRecallWin.Controls.StatBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 状态徽章：ok/warn/danger/info 语义色；入场动画（EntranceThemeTransition） -->
    <Border x:Name="RootBorder" CornerRadius="6" Padding="10,3">
        <Border.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromHorizontalOffset="12" FromVerticalOffset="0" />
            </TransitionCollection>
        </Border.Transitions>
        <TextBlock x:Name="BadgeText" FontSize="12" FontWeight="SemiBold" />
    </Border>
</UserControl>
