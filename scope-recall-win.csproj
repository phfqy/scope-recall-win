<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ScopeRecallWin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- 分发形态：unpackaged 桌面安装版（exe）。不再产出/分发 MSIX。
         WindowsPackageType=None + 自带 Windows App SDK 运行时（见下）。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ScopeRecallWin</AssemblyName>
    <!-- 应用图标（exe 图标；多尺寸由 generate_icons.py 生成） -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.3.8</Version>
    <InformationalVersion>1.3.8</InformationalVersion>
    <!-- 自定义入口：禁用 XAML 生成的 Main，改由 Program.cs 显式初始化
         Windows App SDK Bootstrap（自动初始化在本机会 fail-fast，见 Program.cs 注释）。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>ScopeRecallWin.Program</StartupObject>
    <!-- XAML 编译走 in-proc MSBuild 任务（VS 默认路径）；
         外部 XamlCompiler.exe 进程在本机被安全策略拦截，退出码 1 且无详情。 -->
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinUI 3 / Windows App SDK：核心依赖（1.8 为 1.x 末代，修复 .NET 8 SDK 下的 XAML 编译工具链问题） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- MVVM（CommunityToolkit）：ViewModel 基建 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- 只读 SQLite：读通道（Mode=ReadOnly） -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 所有 XAML 资源自动编译（UseWinUI 已处理，此处仅为显式声明） -->
    <None Update="app.manifest" />
    <!-- 应用图标随输出复制（窗口/任务栏图标由 MainWindow.TrySetIcon 运行时加载） -->
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- 云同步桥：Python 侧脚本随应用分发 -->
    <Content Include="bridge\*.py" CopyToOutputDirectory="PreserveNewest" />
    <!-- 远端接入：CLI / MCP / SKILL 随应用分发到 <安装目录>\remote\，
         远端机器可直接拷这三个文件接进来（无需去仓库翻） -->
    <Content Include="remote\*.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="remote\SKILL.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 注意：unpackaged 形态下的 Windows App SDK 运行时由 Program.cs 显式
       Bootstrap.TryInitialize 激活（不用 WindowsAppSdkBootstrapInitialize 自动注入，
       后者在本机 self-contained 发布下会以 CoreMessagingXP 触发 fail-fast）。 -->
</Project>
