<Application
    x:Class="ScopeRecallWin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 明暗两套主题 token（Fluent 风格，参考 WinUI 3 Gallery / Files） -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark" Source="Theme/Dark.xaml" />
                <ResourceDictionary x:Key="Light" Source="Theme/Light.xaml" />
            </ResourceDictionary.ThemeDictionaries>

            <!-- 语义色（不随主题）：成功/警告/危险/信息 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/ColorsAndBrushes.xaml" />
                <!-- 自定义控件样式：卡片/徽章/LED/表格等 -->
                <ResourceDictionary Source="Theme/FluentControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
