<Window
    x:Class="ScopeRecallWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Scope Recall 记忆工作台">

    <!-- 布局：236px 左导航 + 内容区 + ⌘K 命令面板浮层。
         导航用 Grid/StackPanel/Button 自建，而非 NavigationView ——
         WinUI 3 的 NavigationView 在 unpackaged 形态（桌面 exe 安装版，
         WindowsPackageType=None）下只要承载 Content 就 fail-fast（0xC000027B），
         应用根本起不来。自建导航在 packaged / unpackaged 两种形态下行为一致。
         导航项结构：选中指示条 + 图标 + 主标签 + 副标题（详情摘要）+ 状态角标。 -->
    <Grid x:Name="RootGrid" Background="{StaticResource WindowBackgroundBrush}"
          KeyboardAcceleratorPlacementMode="Hidden">
        <!-- KeyboardAcceleratorPlacementMode=Hidden：Ctrl+K 命令面板的快捷键提示气泡
             不再浮在内容上遮挡文字（快捷键功能保留）。 -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左导航 -->
        <Grid Grid.Column="0" Padding="6,12,6,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Scope Recall 记忆工作台"
                       Style="{StaticResource NavGroupHeaderStyle}"
                       Margin="10,2,10,10"
                       TextWrapping="Wrap" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NavPanel" />
            </ScrollViewer>
        </Grid>

        <!-- 内容区：视图宿主 + 呼出式顶栏搜索。
             搜索栏不再常驻占位：默认收起，滚轮上滑从顶部滑出、下滑收起
             （逻辑在 MainWindow.RootGrid_PointerWheelChanged，捕获已处理的滚轮事件）。 -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="ContentHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                <ContentControl.ContentTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="24" />
                    </TransitionCollection>
                </ContentControl.ContentTransitions>
            </ContentControl>

            <!-- 全局检索入口（呼出式浮层）：搜索范围是本机记忆库的全部原始事件（跨所有助手与会话）。
                 收起态：Visibility=Collapsed + 上移 80dp + 透明；展开态见 AnimateSearchBar。 -->
            <Border x:Name="SearchBar" VerticalAlignment="Top"
                    Padding="26,14,26,10" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    IsHitTestVisible="False" Visibility="Collapsed" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SearchBarShift" Y="-80" />
                </Border.RenderTransform>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="15"
                                  Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="TxtGlobalSearch"
                                 PlaceholderText="在全部记忆中搜索…（Enter 检索，Ctrl+F 聚焦）"
                                 BorderThickness="0" Background="Transparent" Padding="0,6"
                                 KeyDown="TxtGlobalSearch_KeyDown" />
                    </Grid>

                    <Button Grid.Column="1" x:Name="BtnGlobalSearch" Content="检索"
                            Click="BtnGlobalSearch_Click" />
                </Grid>
            </Border>
        </Grid>

        <!-- ⌘K 命令面板浮层（Acrylic），Ctrl+K 唤起：输入过滤 + ↑↓ 选择 + Enter 跳转 + Esc 关闭 -->
        <Grid x:Name="PaletteOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#33000000">
            <Grid MaxWidth="560" VerticalAlignment="Top" Margin="0,80,0,0">
                <Border Background="{StaticResource AcrylicPanelBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBox x:Name="PaletteInput" PlaceholderText="搜索视图、操作或记忆…（↑↓ 选择，Enter 执行，Esc 关闭）"
                                 Padding="14,10" Background="Transparent" BorderThickness="0"
                                 KeyDown="PaletteInput_KeyDown" TextChanged="PaletteInput_TextChanged" />
                        <ListView x:Name="PaletteList" MaxHeight="320" IsItemClickEnabled="True"
                                  ItemClick="PaletteList_ItemClick" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,6">
                                        <TextBlock Text="{Binding Label}" FontSize="13.5" />
                                        <TextBlock Text="{Binding Tip}" FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
