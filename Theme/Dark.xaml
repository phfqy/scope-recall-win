<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 暗色主题 token：Fluent 深色控制台（Win11 标准 Surface 系 + Mica 背景） -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1B1B1F" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#242428" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#2E2E33" />
    <SolidColorBrush x:Key="Surface3Brush" Color="#3A3A40" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A0A0A8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A40" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4FC3F7" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#4FC3F7" Opacity="0.14" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="#062A38" />
</ResourceDictionary>
