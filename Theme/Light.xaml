<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题 token：对应暗色的同一套语义 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#EFEFF2" />
    <SolidColorBrush x:Key="Surface3Brush" Color="#E2E2E7" />
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1F" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5F5F68" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D6D6DC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0288D1" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#0288D1" Opacity="0.12" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF" />
</ResourceDictionary>
