<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 通用文本样式 ============ -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="PageDescTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <!-- WinUI 3 无 TextCharacterSpacing（UWP 专有）；对应属性为 CharacterSpacing（1/100 pt） -->
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>
    <Style x:Key="MonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <!-- ============ 卡片容器（参考 Files 的紧凑卡片） ============ -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ============ 导航分组标题（NavigationViewItemHeader 的紧凑样式） ============ -->
    <!-- 导航分组标题。TargetType 必须是 TextBlock —— 自建导航用 TextBlock 渲染分组名，
         把 NavigationViewItemHeader 的样式套到 TextBlock 上会因类型不匹配触发
         WinRT fail-fast（0xC000027B），应用直接崩溃。 -->
    <Style x:Key="NavGroupHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Margin" Value="12,14,12,4" />
    </Style>

    <!-- ============ 页面切换动画（参考 MS Learn「Page transitions」：
         同级页面水平滑动，进入时从右滑入） ============ -->
    <SlideNavigationTransitionInfo x:Key="NavForwardSlideInfo" Effect="FromRight" />

    <!-- ============ 表格/列表出现动画：列表项入场（EntranceThemeTransition，
         参考 WinUI 3 Gallery 的列表示例） ============ -->
    <Style x:Key="AnimatedListViewStyle" TargetType="ListView">
        <Setter Property="ItemContainerTransitions">
            <Setter.Value>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="24" FromVerticalOffset="0" />
                    <AddDeleteThemeTransition />
                </TransitionCollection>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 危险操作按钮（红字，高危动作统一用它） ============ -->
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <!-- ============ 顶栏工具按钮（图标按钮统一） ============ -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="16" />
    </Style>
</ResourceDictionary>
