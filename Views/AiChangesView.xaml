<UserControl
    x:Class="ScopeRecallWin.Views.AiChangesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScopeRecallWin.Controls">

    <Grid>
        <Grid Padding="26" MaxWidth="1000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="AI 改动" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}"
                               Text="候选生命周期留痕（candidate_lifecycle）：端侧模型每次记忆改动的处理状态与原因。点击行查看关联证据。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnRefresh" Content="刷新" Click="BtnRefresh_Click" />
                    <Button x:Name="BtnExport" Content="导出 JSON" Click="BtnExport_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:FilterPicker Grid.Column="0" x:Name="PickerState" ButtonMinWidth="200" />
                <Button Grid.Column="1" x:Name="BtnApply" Content="筛选" Click="BtnApply_Click" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="TxtTotal" Style="{StaticResource PageDescTextStyle}" Margin="0,0,0,6" />
                <controls:SimpleTable Grid.Row="1" x:Name="Table" EmptyText="没有匹配的候选记录。" />
            </Grid>
        </Grid>

        <controls:DetailDrawer x:Name="Drawer" />
    </Grid>
</UserControl>
