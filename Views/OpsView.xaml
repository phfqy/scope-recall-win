<UserControl
    x:Class="ScopeRecallWin.Views.OpsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScopeRecallWin.Controls">

    <ScrollViewer>
        <StackPanel Padding="26" Spacing="14" MaxWidth="960">
            <TextBlock Text="运维" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Style="{StaticResource PageDescTextStyle}"
                       Text="entries 台账、记忆库备份与高级维护入口。所有写操作需授权句 + 确认，且只走官方 CLI。" />

            <!-- entries 台账 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionHeaderTextStyle}"
                                   Text="entries（共享库成员）" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="BtnRefreshEntries" Content="刷新"
                                Click="BtnRefreshEntries_Click" />
                    </Grid>
                    <TextBlock x:Name="TxtEntriesState" Style="{StaticResource PageDescTextStyle}"
                               Text="点击「刷新」读取 entries。" TextWrapping="Wrap" />
                    <ListView x:Name="EntryList" MaxHeight="240">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,5">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Meta}" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- 备份 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="记忆库备份" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                               Text="调用官方 backup CLI 生成一致性快照（quick_check + sha256 回执）。备份文件写入根目录 _upgrade-console\\backups\\。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnBackup" Content="立即备份"
                                Style="{StaticResource DangerButtonStyle}" Click="BtnBackup_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtBackupState" Style="{StaticResource PageDescTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 高级维护 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="高级维护" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                               Text="以下操作为有界页面处理，执行前会自动备份策略不覆盖——请谨慎并在低峰期运行。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnRequalify" Content="重新判定候选（requalify）"
                                Click="BtnMaintenance_Click" Tag="requalify" />
                        <Button x:Name="BtnRespace" Content="重建向量空间（respace-embeddings）"
                                Click="BtnMaintenance_Click" Tag="respace-embeddings" />
                    </StackPanel>
                    <TextBlock x:Name="TxtMaintenanceState" Style="{StaticResource PageDescTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
