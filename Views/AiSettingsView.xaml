<UserControl
    x:Class="ScopeRecallWin.Views.AiSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScopeRecallWin.Controls">

    <ScrollViewer>
        <StackPanel Padding="26" Spacing="14" MaxWidth="900">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="AI 设置" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                               Text="选择服务商、填入 API Key 即可使用；更细的参数在下方「高级设置」中按需展开。" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnReload" Content="重新读取"
                        VerticalAlignment="Center" Click="BtnReload_Click" />
            </Grid>

            <TextBlock x:Name="TxtConfigPath" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" />

            <!-- ============ 基本设置（三步完成） ============ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="基本设置（三步完成）" />

                    <controls:FilterPicker x:Name="PickerProvider" Header="第 1 步 · 选择服务商（自动填好接口地址）"
                                           ButtonMinWidth="300" />

                    <TextBox x:Name="TxtSimpleModel" Header="第 2 步 · 模型名称"
                             PlaceholderText="例如 embedding-3" />

                    <TextBlock x:Name="TxtSimpleEndpointInfo" Style="{StaticResource PageDescTextStyle}"
                               TextWrapping="Wrap" />

                    <PasswordBox x:Name="PwdApiKey"
                                 Header="第 3 步 · API Key（只保存在 Windows 凭据管理器，不写入配置文件）"
                                 PlaceholderText="粘贴 API Key" />

                    <TextBlock x:Name="TxtKeyState" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnSimpleSave" Content="保存并测试连接"
                                Style="{StaticResource AccentButtonStyle}" Click="BtnSimpleSave_Click" />
                        <Button x:Name="BtnSimpleTest" Content="仅测试连接" Click="BtnSimpleTest_Click" />
                    </StackPanel>

                    <TextBlock x:Name="TxtSimpleResult" TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>

            <!-- ============ 高级设置（折叠） ============ -->
            <Expander x:Name="AdvExpander" Header="高级设置（技术参数，通常无需修改）"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" Padding="0,8,0,0">

                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="嵌入模型（把记忆转成向量的模型）" />
                    <TextBox x:Name="TxtEmbeddingModel" Header="模型名称" />
                    <TextBox x:Name="TxtEmbeddingEndpoint" Header="接口地址" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtEmbeddingDimensions" Header="向量维度" />
                        <TextBox Grid.Column="1" x:Name="TxtEmbeddingCredentialEnv" Header="Key 存储名（环境变量名）" />
                    </Grid>
                    <ToggleSwitch x:Name="TglExternalEmbedding" Header="启用外部嵌入服务" />

                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="整合模型（把记忆整理成条目的模型）" />
                    <TextBox x:Name="TxtConsolidationModel" Header="模型名称" />
                    <TextBox x:Name="TxtConsolidationEndpoint" Header="接口地址" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtConsolidationKind" Header="接口类型" />
                        <TextBox Grid.Column="1" x:Name="TxtMaxOutputTokens" Header="单次最大输出长度" />
                    </Grid>
                    <ToggleSwitch x:Name="TglExternalConsolidation" Header="启用外部整合服务" />

                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="检索灵敏度" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                               Text="相似度阈值（0~1）：数值越高，只有更贴近的记忆才会被召回。" />
                    <TextBox x:Name="TxtVectorThreshold" Header="相似度阈值" Width="160"
                             HorizontalAlignment="Left" />

                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="保存高级配置" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnSaveAdv" Content="保存高级配置"
                                Style="{StaticResource DangerButtonStyle}" Click="BtnSave_Click" />
                        <Button x:Name="BtnTestEmbedding" Content="测试嵌入接口"
                                Click="BtnTestEmbedding_Click" />
                        <Button x:Name="BtnTestConsolidation" Content="测试整合接口"
                                Click="BtnTestConsolidation_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtEmbeddingTest" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtConsolidationTest" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtSaveState" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <!-- ============ 凭据管理 ============ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="凭据管理" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                               Text="API Key 保存在 Windows 凭据管理器（不回显、不写日志、不进配置文件）；删除后运行时将回退读取 shared 目录下的 .env 文件。" />
                    <Button x:Name="BtnDeleteKey" Content="删除已保存的 Key" Click="BtnDeleteKey_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
