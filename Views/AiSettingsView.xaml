<UserControl
    x:Class="ScopeRecallWin.Views.AiSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="26" Spacing="14" MaxWidth="900">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="AI 设置" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}"
                               Text="记忆所用大模型配置（runtime-config.json）。API Key 存入 Windows 凭据管理器，不落配置文件、不出现在日志。" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnReload" Content="重新读取" Click="BtnReload_Click"
                        VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="TxtConfigPath" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" />

            <!-- 嵌入模型 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="嵌入模型（embedding，向量化记忆）" />
                    <TextBox x:Name="TxtEmbeddingModel" Header="model" />
                    <TextBox x:Name="TxtEmbeddingEndpoint" Header="endpoint" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtEmbeddingDimensions" Header="dimensions" />
                        <TextBox Grid.Column="1" x:Name="TxtEmbeddingCredentialEnv" Header="credential_env（环境变量名）" />
                    </Grid>
                    <ToggleSwitch x:Name="TglExternalEmbedding" Header="启用外部嵌入（external_embedding）" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnTestEmbedding" Content="测试连接" Click="BtnTestEmbedding_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtEmbeddingTest" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 整合模型 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="整合模型（consolidation，提炼 claim）" />
                    <TextBox x:Name="TxtConsolidationModel" Header="model" />
                    <TextBox x:Name="TxtConsolidationEndpoint" Header="endpoint" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtConsolidationKind" Header="kind（如 openai）" />
                        <TextBox Grid.Column="1" x:Name="TxtMaxOutputTokens" Header="max_output_tokens" />
                    </Grid>
                    <ToggleSwitch x:Name="TglExternalConsolidation" Header="启用外部整合（external_consolidation）" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnTestConsolidation" Content="测试连接" Click="BtnTestConsolidation_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtConsolidationTest" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 检索阈值 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="向量检索阈值" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                               Text="vector_threshold：语义召回的最低相似度（0~1）。值越高召回越严格。" />
                    <TextBox x:Name="TxtVectorThreshold" Header="vector_threshold" Width="160"
                             HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- API Key -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="API Key（Windows 凭据管理器）" />
                    <TextBlock x:Name="TxtKeyState" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
                    <PasswordBox x:Name="PwdApiKey" PlaceholderText="粘贴 API Key（不回显、不落盘）" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnSaveKey" Content="保存到凭据管理器" Click="BtnSaveKey_Click" />
                        <Button x:Name="BtnDeleteKey" Content="删除已存 Key" Click="BtnDeleteKey_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 保存 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="保存配置" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                               Text="保存前自动备份原配置文件到 _upgrade-console\\runtime-config-*.json，采用保序更新（其他字段原样保留）。" />
                    <TextBox x:Name="TxtAuthorization" Header="授权句（本人书写，≥6 字）"
                             PlaceholderText="例：我确认修改本机记忆库的模型配置" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnSave" Content="保存配置"
                                Style="{StaticResource DangerButtonStyle}" Click="BtnSave_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtSaveState" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
