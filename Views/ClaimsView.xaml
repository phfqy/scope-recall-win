<UserControl
    x:Class="ScopeRecallWin.Views.ClaimsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScopeRecallWin.Controls">
    <Grid Padding="26" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="记忆" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Grid.Row="1" Text="claim 全量列表 · 状态机过滤（proposed/active/disputed/superseded/retracted 五状态 + suppressed 布尔列；无 deleted 状态——删除走 forget mode=delete 的 deletion_operations）+ temporal（current/expired）+ 类型 + scope/project/branch + 关键词；行点击打开证据链（evidence_refs、revision、source_contexts、basis、conditions、valid_from/to）；导出 JSON/CSV（防公式注入）。对应附 1 第 3、4 项。"
                   Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
        <controls:Card Grid.Row="2" Title="待 P1 实现">
            <StackPanel Spacing="8">
                <TextBlock Text="• 过滤器：状态 / 类型 / scope / project / branch / 关键词" Style="{StaticResource MonoTextStyle}" />
                <TextBlock Text="• 表格：DataGrid 或 ItemsControl（附 1 第 3 项 claim 状态机）" Style="{StaticResource MonoTextStyle}" />
                <TextBlock Text="• 证据链弹窗：ContentDialog（附 1 第 4 项证据口径 claim=`=`、episode=`&lt;=`）" Style="{StaticResource MonoTextStyle}" />
                <TextBlock Text="• 导出：FileSavePicker + CSV 公式注入转义（约束 8）" Style="{StaticResource MonoTextStyle}" />
            </StackPanel>
        </controls:Card>
    </Grid>
</UserControl>
