<UserControl
    x:Class="ScopeRecallWin.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScopeRecallWin.Controls">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="26" Spacing="14" MaxWidth="960">

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="总览" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Style="{StaticResource PageDescTextStyle}"
                                   Text="记忆库规模、健康分与需要关注的事项。全部数据来自本机只读查询。" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border x:Name="SourceBadge" CornerRadius="4" Padding="8,3"
                                Background="{StaticResource Surface2Brush}">
                            <TextBlock x:Name="TxtSourceBadge" Text="检测中…" FontSize="11.5"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Border>
                        <Button x:Name="BtnRefresh" Content="刷新" Click="BtnRefresh_Click" />
                    </StackPanel>
                </Grid>

                <!-- 统计卡 -->
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="记忆总数" Style="{StaticResource PageDescTextStyle}" />
                            <TextBlock x:Name="TxtClaimTotal" Text="—" FontSize="24"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="TxtClaimSplit" Text="" Style="{StaticResource MonoTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="记忆事件" Style="{StaticResource PageDescTextStyle}" />
                            <TextBlock x:Name="TxtEventTotal" Text="—" FontSize="24"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="TxtNewestEvent" Text="" Style="{StaticResource MonoTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="存储占用" Style="{StaticResource PageDescTextStyle}" />
                            <TextBlock x:Name="TxtDbSize" Text="—" FontSize="24"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="TxtSchema" Text="" Style="{StaticResource MonoTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="待处理候选" Style="{StaticResource PageDescTextStyle}" />
                            <TextBlock x:Name="TxtCandidateWaiting" Text="—" FontSize="24"
                                       FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="waiting_evidence 状态" Style="{StaticResource MonoTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="后台任务" Style="{StaticResource PageDescTextStyle}" />
                            <TextBlock x:Name="TxtWorkTotal" Text="—" FontSize="24"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="TxtWorkSplit" Text="" Style="{StaticResource MonoTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="记忆库位置" Style="{StaticResource PageDescTextStyle}" />
                            <TextBlock x:Name="TxtDataDir" Text="—" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="TxtAgentId" Text="" Style="{StaticResource MonoTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 健康分 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="TxtHealthScore" Text="—" FontSize="34"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="记忆健康分" Style="{StaticResource PageDescTextStyle}" />
                                <ProgressBar x:Name="HealthBar" Maximum="100" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="扣分项（WebUI 同口径）" Style="{StaticResource SectionHeaderTextStyle}" />
                        <StackPanel x:Name="HealthList" Spacing="6" />
                    </StackPanel>
                </Border>

                <!-- 需要关注 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="需要关注" Style="{StaticResource SectionHeaderTextStyle}" />
                        <StackPanel x:Name="AttentionList" Spacing="8" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <controls:DetailDrawer x:Name="Drawer" />
    </Grid>
</UserControl>
