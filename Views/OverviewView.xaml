<UserControl
    x:Class="ScopeRecallWin.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="26" Spacing="14" MaxWidth="960">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="总览" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}"
                               Text="记忆库的整体情况。所有数据都来自本机记忆库，实时读取。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border x:Name="SourceBadge" CornerRadius="4" Padding="8,3"
                            Background="{StaticResource Surface2Brush}">
                        <TextBlock x:Name="TxtSourceBadge" Text="正在读取…" FontSize="11.5"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </Border>
                    <Button x:Name="BtnRefresh" Content="刷新" Click="BtnRefresh_Click" />
                </StackPanel>
            </Grid>

            <!-- ============ 一句话结论 ============ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="TxtHealthScore" Text="—" FontSize="40"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHealthTitle" Text="正在检查…" FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtHealthSummary" Style="{StaticResource PageDescTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <ProgressBar x:Name="HealthBar" Maximum="100" />

                    <Expander Header="查看评分明细（5 项）" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="HealthList" Spacing="8" Padding="0,8,0,0" />
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ============ 四个关键数字 ============ -->
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="记忆条目" Style="{StaticResource PageDescTextStyle}" />
                        <TextBlock x:Name="TxtClaimTotal" Text="—" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtClaimHint" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="后台任务" Style="{StaticResource PageDescTextStyle}" />
                        <TextBlock x:Name="TxtWorkTotal" Text="—" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtWorkHint" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="待确认候选" Style="{StaticResource PageDescTextStyle}" />
                        <TextBlock x:Name="TxtCandidateWaiting" Text="—" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtCandidateHint" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="记忆库占用" Style="{StaticResource PageDescTextStyle}" />
                        <TextBlock x:Name="TxtDbSize" Text="—" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtDbHint" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ 需要关注 ============ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="需要关注" />
                    <StackPanel x:Name="AttentionList" Spacing="8" />
                </StackPanel>
            </Border>

            <!-- ============ 更多信息（折叠） ============ -->
            <Expander Header="更多信息（事件数量 / 记忆库位置 / 版本）" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <Grid Padding="0,8,0,0" ColumnSpacing="12" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="记忆事件" Style="{StaticResource PageDescTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtEventTotal" Style="{StaticResource MonoTextStyle}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="最近活动" Style="{StaticResource PageDescTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtNewestEvent" Style="{StaticResource MonoTextStyle}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="记忆库位置" Style="{StaticResource PageDescTextStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDataDir" Style="{StaticResource MonoTextStyle}"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="数据结构版本" Style="{StaticResource PageDescTextStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtSchema" Style="{StaticResource MonoTextStyle}" />
                </Grid>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
