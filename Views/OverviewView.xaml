<UserControl
    x:Class="ScopeRecallWin.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScopeRecallWin.Controls">
    <ScrollViewer>
        <StackPanel Padding="26" Spacing="16">

            <TextBlock Text="总览" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="存储、规模、分布与趋势 · 当前为演示快照，P2 接入真实只读查询（Microsoft.Data.Sqlite Mode=ReadOnly）"
                       Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />

            <!-- 统计卡（入场动画：列表/卡片出现时水平滑入，参考 WinUI 3 Gallery） -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:Card Title="claim 总数">
                    <StackPanel>
                        <TextBlock Text="12,847" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="active 占比 68%" Style="{StaticResource MonoTextStyle}" />
                    </StackPanel>
                </controls:Card>
                <controls:Card Grid.Column="1" Title="memory_epoch">
                    <StackPanel>
                        <TextBlock Text="2,707" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="订阅新变更 → 系统通知" Style="{StaticResource MonoTextStyle}" />
                    </StackPanel>
                </controls:Card>
                <controls:Card Grid.Column="2" Title="存储体积">
                    <StackPanel>
                        <TextBlock Text="48.2 MB" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="sqlite 42.1 + vectors 6.1" Style="{StaticResource MonoTextStyle}" />
                    </StackPanel>
                </controls:Card>
                <controls:Card Grid.Column="3" Title="今日增长">
                    <StackPanel>
                        <TextBlock Text="+1,204" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="WAL 写入中（正常）" Style="{StaticResource MonoTextStyle}" />
                    </StackPanel>
                </controls:Card>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 记忆健康分：口径（证据单薄率/待审积压/未解决更新/失败工作/词法索引覆盖）可复算，P2 接库 -->
                <controls:Card Title="记忆健康分">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ProgressBar x:Name="HealthBar" Value="78" Maximum="100" Width="200" VerticalAlignment="Center" />
                            <TextBlock Text="78 / 100" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="扣分项（每项标注数值与处理建议，口径固定可复算）" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ItemsControl>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:StatusLed State="Warn" />
                                <TextBlock Text="证据单薄率 12%" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:StatusLed State="Warn" />
                                <TextBlock Text="待审积压 86 条（建议开启 worker）" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:StatusLed State="Ok" />
                                <TextBlock Text="未解决更新 3 条" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:StatusLed State="Ok" />
                                <TextBlock Text="失败工作 0 条" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:StatusLed State="Info" />
                                <TextBlock Text="词法索引覆盖 100%" />
                            </StackPanel>
                        </ItemsControl>
                    </StackPanel>
                </controls:Card>

                <!-- 需要关注：能力缺口按严重度着色（Danger/Warn/Info），对应诊断页缺口体系 -->
                <controls:Card Grid.Column="1" Title="需要关注">
                    <ItemsControl>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <controls:StatBadge State="Danger" Text="FAILED" />
                            <TextBlock Text="vector_threshold 未配置 → 召回降级词法" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <controls:StatBadge State="Warn" Text="PENDING" />
                            <TextBlock Text="86 个候选待评估（worker 运行中会消化）" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <controls:StatBadge State="Info" Text="INFO" />
                            <TextBlock Text="storage_budget 未设上限（0=不限）" TextWrapping="Wrap" />
                        </StackPanel>
                    </ItemsControl>
                </controls:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
