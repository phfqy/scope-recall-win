<UserControl
    x:Class="ScopeRecallWin.Views.QueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScopeRecallWin.Controls">
    <Grid Padding="26" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="查询" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Grid.Row="1" Text="三入口（均只读、不写库、不额外调模型）：recall（语义召回+词法回退+预算展示）、trace（2-3 跳有界证据路径，超限标 partial）、entity（一跳精确视图，value_text 整段相等，conditions 保留）。对应附 1 第 5、6、8 项。"
                   Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
        <controls:Card Grid.Row="2" Title="待 P1/P2 实现">
            <StackPanel Spacing="8">
                <TextBlock Text="• recall：显示向量/词法通道、vector_threshold 命中、packet 预算（自动 4096 / 最多 6 项）" Style="{StaticResource MonoTextStyle}" />
                <TextBlock Text="• trace：预算 bound（24 节点/12 路径/16KiB，硬上限 3跳/64 节点/30 路径/64KiB/5s）" Style="{StaticResource MonoTextStyle}" />
                <TextBlock Text="• entity：probe=出边 fact / related=出边+入边，incoming/outgoing/both" Style="{StaticResource MonoTextStyle}" />
            </StackPanel>
        </controls:Card>
    </Grid>
</UserControl>
