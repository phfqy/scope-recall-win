<UserControl
    x:Class="ScopeRecallWin.Views.QueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScopeRecallWin.Controls">

    <Grid>
        <Grid Padding="26" MaxWidth="1000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="查询" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Style="{StaticResource PageDescTextStyle}"
                           Text="只读查询四件套：词法检索 / 链路追溯 / 主题聚合 / 实体匹配。全部直连本机记忆库，不调模型。" />
            </StackPanel>

            <TabView Grid.Row="1" Margin="0,12,0,0" x:Name="QueryTabs">
                <TabViewItem Header="词法检索" x:Name="TabLexical" />
                <TabViewItem Header="链路追溯" x:Name="TabTrace" />
                <TabViewItem Header="主题聚合" x:Name="TabProfile" />
                <TabViewItem Header="实体匹配" x:Name="TabEntity" />
            </TabView>

            <Grid Grid.Row="2" Margin="0,12,0,0">

                <!-- 词法检索 -->
                <Grid x:Name="PanelLexical" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtLexical" PlaceholderText="关键词（中文二元切分，如：部署 / 插件）"
                                 KeyDown="AnyEnter_KeyDown" />
                        <Button Grid.Column="1" Content="检索" Click="BtnLexical_Click" />
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="TxtLexicalResult" Style="{StaticResource PageDescTextStyle}" Margin="0,8" />
                    <ListView Grid.Row="2" x:Name="LexicalList" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="SharedList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,6">
                                    <TextBlock Text="{Binding Head}" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Summary}" FontSize="12.5" TextWrapping="Wrap"
                                               MaxLines="3" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- 链路追溯 -->
                <Grid x:Name="PanelTrace" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtTrace" PlaceholderText="claim_id 或 event_id"
                                 KeyDown="AnyEnter_KeyDown" />
                        <Button Grid.Column="1" Content="追溯" Click="BtnTrace_Click" />
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="TxtTraceResult" Style="{StaticResource PageDescTextStyle}"
                               Margin="0,8" TextWrapping="Wrap" />
                    <ListView Grid.Row="2" x:Name="TraceList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- 主题聚合 -->
                <Grid x:Name="PanelProfile" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="TxtProfileResult" Style="{StaticResource PageDescTextStyle}"
                               Margin="0,0,0,8" />
                    <ListView Grid.Row="1" x:Name="ProfileList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- 实体匹配 -->
                <Grid x:Name="PanelEntity" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtEntity" PlaceholderText="subject 实体（精确或模糊）"
                                 KeyDown="AnyEnter_KeyDown" />
                        <Button Grid.Column="1" Content="匹配" Click="BtnEntity_Click" />
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="TxtEntityResult" Style="{StaticResource PageDescTextStyle}" Margin="0,8" />
                    <controls:SimpleTable Grid.Row="2" x:Name="EntityTable" EmptyText="没有匹配该实体的 claim。" />
                </Grid>
            </Grid>
        </Grid>

        <controls:DetailDrawer x:Name="Drawer" />
    </Grid>
</UserControl>
