<UserControl
    x:Class="ScopeRecallWin.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScopeRecallWin.Controls">
    <Grid Padding="26" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="检索" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Grid.Row="1" Text="词法关键词检索（区别于查询页的语义召回）：独立「按词检索」语义与结果计数。对应附 1 第 5 项的词法通道。"
                   Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
        <controls:Card Grid.Row="2" Title="待 P1/P2 实现">
            <StackPanel Spacing="8">
                <TextBlock Text="• 检索框 + 结果列表（命中计数、按 scope/project 过滤）" Style="{StaticResource MonoTextStyle}" />
                <TextBlock Text="• 结果行点击 → 跳 claim 证据链弹窗（与记忆页共用）" Style="{StaticResource MonoTextStyle}" />
            </StackPanel>
        </controls:Card>
    </Grid>
</UserControl>
