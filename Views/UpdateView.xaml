<UserControl
    x:Class="ScopeRecallWin.Views.UpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScopeRecallWin.Controls">
    <Grid Padding="26" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="更新" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Grid.Row="1" Text="一键更新插件本体：当前/最新版本、变更说明（CHANGELOG 关联 release）、检查时间、所用通道（GitHub 直连/镜像）、全流程（预检/备份/下载/sha256 校验/停 worker/替换/起 worker/自检/失败自动回滚）+ 更新日志。对应附 1 第 29 项。"
                   Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
        <controls:Card Grid.Row="2" Title="待 P1/P4 实现">
            <StackPanel Spacing="8">
                <TextBlock Text="• 版本源：Services/UpdateService（HttpClient 读 GitHub release，失败自动切镜像）" Style="{StaticResource MonoTextStyle}" />
                <TextBlock Text="• 校验：SHA256SUMS 比对，不一致即中止并回滚（&lt;APP&gt;\backups\&lt;版本&gt;-&lt;时间戳&gt;）" Style="{StaticResource MonoTextStyle}" />
                <TextBlock Text="• 保数据：任何步骤不碰 &lt;STORE&gt; 与用户配置目录；日志 &lt;APP&gt;\logs\update.log" Style="{StaticResource MonoTextStyle}" />
            </StackPanel>
        </controls:Card>
    </Grid>
</UserControl>
