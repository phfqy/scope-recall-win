<UserControl
    x:Class="ScopeRecallWin.Views.InstallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="26" Spacing="14" MaxWidth="880">

            <TextBlock Text="安装" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                       Text="在本机部署记忆插件，三步完成：① 选目录 ② 确认 ③ 开始。目录由你自主选择，控制台与 Agent 都能读写该目录。" />

            <!-- ============ 当前状态 ============ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" x:Name="EnvLed" Width="12" Height="12" CornerRadius="6"
                            Background="#8A8A92" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="TxtEnvHeadline" Text="正在检查本机环境…" FontSize="13.5"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtEnvDetail" Style="{StaticResource PageDescTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="BtnRefreshEnv" Content="重新检测"
                            VerticalAlignment="Center" Click="BtnRefreshEnv_Click" />
                </Grid>
            </Border>

            <!-- ============ 第 1 步：选择目录 ============ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="第 1 步 · 选择部署目录" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                               Text="记忆数据与插件运行环境都会放在这个目录下。建议选一个空间充足的盘（如 E 盘），目录需允许控制台与 Agent 双方读写。" />

                    <TextBox x:Name="TxtTargetRoot" PlaceholderText="选择或直接输入目录，例如 E:\ScopeRecall" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnBrowse" Content="浏览…" Click="BtnBrowse_Click" />
                        <Button x:Name="BtnUseDefault" Content="使用 E:\ScopeRecall" Click="BtnUseDefault_Click" />
                        <Button x:Name="BtnUseAppDir" Content="使用软件安装目录" Click="BtnUseAppDir_Click" />
                    </StackPanel>

                    <TextBlock x:Name="TxtRootState" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ============ 第 2 步：确认并开始 ============ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="第 2 步 · 确认并开始" />

                    <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                               Text="如果该目录已有记忆库，只会做校验与权限检查（不重装）；否则会新建插件运行环境与记忆库。" />

                    <CheckBox x:Name="ChkConfirm"
                              Content="我确认在本机部署记忆插件（新部署约占用 1.5 GB 磁盘，需要几分钟）" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnDeploy" Content="开始部署"
                                Style="{StaticResource AccentButtonStyle}" Click="BtnDeploy_Click" />
                        <Button x:Name="BtnPlan" Content="查看部署计划" Click="BtnPlan_Click" />
                    </StackPanel>

                    <TextBlock x:Name="TxtDeployState" TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{StaticResource MutedTextBrush}" />

                    <ListView x:Name="DeployLogList" MaxHeight="220" Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="TxtEnvError" Style="{StaticResource PageDescTextStyle}"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- ============ 折叠：部署计划预览 ============ -->
            <Expander Header="部署计划预览（技术细节）" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Padding="0,8,0,0">
                    <ListView x:Name="PlanList" MaxHeight="200">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12.5"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="TxtPlanWarning" Style="{StaticResource PageDescTextStyle}"
                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
