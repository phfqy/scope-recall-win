<UserControl
    x:Class="ScopeRecallWin.Views.InstallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="26" Spacing="14" MaxWidth="860">

            <TextBlock Text="安装" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Style="{StaticResource PageDescTextStyle}"
                       Text="在本机一键部署记忆插件（hermes-scope-recall）。部署目录由你自主选择；控制台与 Agent 双方均可读写该目录。" />

            <!-- ============ 环境检测 ============ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="当前环境" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="记忆库根目录"
                                   Style="{StaticResource PageDescTextStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtRoot"
                                   Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="已装版本" Style="{StaticResource PageDescTextStyle}" />
                        <TextBlock Grid.Column="1" x:Name="TxtInstalled" Style="{StaticResource MonoTextStyle}" />
                        <TextBlock Grid.Column="2" Text="外部 uv" Style="{StaticResource PageDescTextStyle}" />
                        <TextBlock Grid.Column="3" x:Name="TxtUv" Style="{StaticResource MonoTextStyle}" />
                    </Grid>
                    <TextBlock x:Name="TxtEnvError" Style="{StaticResource PageDescTextStyle}"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <Button x:Name="BtnRefreshEnv" Content="重新检测" Click="BtnRefreshEnv_Click" />
                </StackPanel>
            </Border>

            <!-- ============ 部署目录 ============ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="部署目录" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                               Text="记忆库根目录（shared\\ 记忆数据 + shared-venv\\ 插件环境）将创建/复用于此。要求：控制台软件与 Agent 双方均可读写。" />

                    <TextBox x:Name="TxtTargetRoot" PlaceholderText="选择或输入目录，例如 E:\ScopeRecall" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnBrowse" Content="浏览…" Click="BtnBrowse_Click" />
                        <Button x:Name="BtnUseDefault" Content="使用 E:\ScopeRecall" Click="BtnUseDefault_Click" />
                        <Button x:Name="BtnUseAppDir" Content="使用软件安装目录" Click="BtnUseAppDir_Click" />
                    </StackPanel>

                    <TextBlock x:Name="TxtRootState" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ============ 部署计划 ============ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="部署计划" />
                    <ListView x:Name="PlanList" MaxHeight="200">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12.5"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="TxtPlanWarning" Style="{StaticResource PageDescTextStyle}"
                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <Button x:Name="BtnPlan" Content="生成部署计划" Click="BtnPlan_Click" />
                </StackPanel>
            </Border>

            <!-- ============ 执行 ============ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="执行部署" />
                    <TextBox x:Name="TxtAuthorization" PlaceholderText="授权句（本人书写，≥6 字，必填。例：我确认在所选目录部署记忆插件）" />
                    <CheckBox x:Name="ChkConfirm" Content="我已了解部署将在所选目录创建 venv 与记忆库（复用模式下仅校验）" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnDeploy" Content="开始部署" Click="BtnDeploy_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtDeployState" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
                    <ListView x:Name="DeployLogList" MaxHeight="220">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
