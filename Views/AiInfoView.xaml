<UserControl
    x:Class="ScopeRecallWin.Views.AiInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="26" Spacing="14" MaxWidth="1000">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="AI 模型" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}"
                               Text="Agent 链接状态（配置注册 + resident 常驻 + 最后活跃）与后台任务统计。" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnRefresh" Content="重新探测" Click="BtnRefresh_Click"
                        VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="TxtSummary" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />

            <ListView x:Name="LinkList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,4">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Health}" FontSize="12"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <TextBlock Text="{Binding Detail}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="后台任务统计（本机记忆库）" />
                    <TextBlock x:Name="TxtWorkStats" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="硬边界" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                               Text="控制台只读记忆库 + 经官方 CLI 执行安全写操作；不直接调用大模型推理，不伪造 Agent 身份。模型与时延数据未记录时一律显示「未记录」，不做推算。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
