<UserControl
    x:Class="ScopeRecallWin.Views.MutateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScopeRecallWin.Controls">

    <ScrollViewer>
        <StackPanel Padding="26" Spacing="14" MaxWidth="900">
            <TextBlock Text="变更" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                       Text="人工修改记忆（Hermes adapter 工具面 revise / forget，协议 v1.1）。表单按上游 schema 实时预校验；写入通道（resident / MCP）将在下一期接入，本页当前提供完整的请求构造与校验。" />

            <TabView x:Name="MutateTabs">
                <TabViewItem Header="revise（纠正 / 撤回）">
                    <ScrollViewer>
                        <StackPanel Spacing="10" Padding="0,10,0,0">
                            <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                                       Text="纠正一条记忆：给出新值即改写（旧值留作历史版本）；new_value 留空 = 撤回该记忆。" />
                            <TextBox x:Name="RevTargetRef" Header="target_ref（必填，如 claim_id 或 claim_id@revision）" />
                            <TextBox x:Name="RevExpectedRevision" Header="expected_revision（乐观并发，≥1）" Text="1" />
                            <TextBox x:Name="RevNewValue" Header="new_value（JSON；留空 = 撤回）"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                                     PlaceholderText='例如 {"value_text": "新的值"}' />
                            <TextBox x:Name="RevConditions" Header="conditions（每行一条，最多 16）"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="72" />
                            <TextBox x:Name="RevEvidenceRefs" Header="source_evidence_refs（每行一个，1..32 且唯一）"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="72" />
                            <TextBox x:Name="RevValidFrom" Header="valid_from（可选，ISO 8601）"
                                     PlaceholderText="2026-10-13T00:00:00+08:00" />
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="forget（停用 / 抹除）">
                    <ScrollViewer>
                        <StackPanel Spacing="10" Padding="0,10,0,0">
                            <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                                       Text="suppress：停用（不再主动使用、仍可按需读取，不可撤销）。delete：抹除（连同来源消息及其它事实一并删除，不可撤销）。" />
                            <TextBox x:Name="ForTargetRefs" Header="target_refs（每行一个，1..100 且唯一）"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="96" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="mode" Style="{StaticResource PageDescTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <RadioButton x:Name="ForModeSuppress" Content="suppress（停用）"
                                                 GroupName="ForgetMode" IsChecked="True" />
                                    <RadioButton x:Name="ForModeDelete" Content="delete（抹除，不可撤销）"
                                                 GroupName="ForgetMode" />
                                </StackPanel>
                            </StackPanel>
                            <TextBox x:Name="ForExpectedRevisions" Header="expected_revisions（每行 ref=revision）"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                                     PlaceholderText="claim_xxx=3" />
                            <TextBox x:Name="ForReason" Header="reason（可选，≤1024）" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
            </TabView>

            <!-- 授权句 + 校验 + 预览 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="授权与校验" />
                    <TextBox x:Name="TxtAuthorization"
                             Header="授权句（本人书写，≥6 字且需点明 target_ref；不代笔 / 不预填）"
                             TextWrapping="Wrap"
                             PlaceholderText="例：我确认把 claim_xxx 的值改为新值" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnValidate" Content="预校验并预览请求" Click="BtnValidate_Click" />
                        <Button x:Name="BtnExecute" Content="执行变更"
                                Style="{StaticResource DangerButtonStyle}" Click="BtnExecute_Click" />
                    </StackPanel>

                    <TextBlock x:Name="TxtValidation" Style="{StaticResource PageDescTextStyle}"
                               TextWrapping="Wrap" Text="填写表单后点击「预校验并预览请求」。" />
                    <TextBlock x:Name="TxtEnvelope" Style="{StaticResource MonoTextStyle}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
