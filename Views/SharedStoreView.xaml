<UserControl
    x:Class="ScopeRecallWin.Views.SharedStoreView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScopeRecallWin.Controls">

    <ScrollViewer>
        <StackPanel Padding="26" Spacing="14" MaxWidth="960">
            <TextBlock Text="共享存储" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                       Text="一个共享记忆库 + 多个 Agent entry（每个宿主 attach 一次）。attach 后各宿主写入同一记忆库，权限按其原有 grants 继承。" />

            <!-- 当前库信息 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionHeaderTextStyle}"
                                   Text="当前共享库" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="BtnRefresh" Content="刷新" Click="BtnRefresh_Click" />
                    </Grid>
                    <TextBlock x:Name="TxtRoot" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtState" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
                    <ListView x:Name="EntryList" MaxHeight="200">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,5">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Meta}" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- attach 向导 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="attach 新 entry（让某个宿主接入共享库）" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                               Text="attach 会为该宿主的 home 建立 entry，并把它的记忆并入共享库。需要宿主已安装插件且能让出原库（自动备份）。" />

                    <ComboBox x:Name="CmbHost" Header="host" Width="240" SelectedIndex="0">
                        <ComboBoxItem Content="dsh" />
                        <ComboBoxItem Content="workbuddy" />
                        <ComboBoxItem Content="codex" />
                        <ComboBoxItem Content="claude-code" />
                        <ComboBoxItem Content="hermes" />
                    </ComboBox>
                    <TextBox x:Name="TxtEntryId" Header="entry（2..32 位小写字母/数字/连字符）"
                             PlaceholderText="workbuddy" />
                    <TextBox x:Name="TxtDisplayName" Header="display_name（≤32 字符）"
                             PlaceholderText="WorkBuddy" />
                    <TextBox x:Name="TxtInstanceRoot" Header="instance_root（宿主 home，如 C:\Users\me\.workbuddy）"
                             PlaceholderText="C:\Users\me\.workbuddy" />
                    <TextBox x:Name="TxtAttachAuth" Header="授权句（本人书写，≥6 字且点明 entry）" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnAttach" Content="执行 attach"
                                Style="{StaticResource DangerButtonStyle}" Click="BtnAttach_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtAttachState" Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- init-shared 说明 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="新建共享库（init-shared）" />
                    <TextBlock Style="{StaticResource PageDescTextStyle}" TextWrapping="Wrap"
                               Text="在所选根目录创建全新的共享记忆库（生成 installation.json）。请在「安装」页选择目录后执行部署；已存在库时走复用模式，不会重建。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
